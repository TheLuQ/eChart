            "agenda": [
                {
                    "time": "19:30",
                    "title": "Welcome and Introduction",
                    "description": "Opening remarks and event overview"
                },
                {
                    "time": "19:45",
                    "title": "Bach - Brandenburg Concerto No. 3",
                    "description": "Performed by the chamber orchestra"
                },
                {
                    "time": "20:15",
                    "title": "Intermission",
                    "description": "15-minute break with refreshments"
                },
                {
                    "time": "20:30",
                    "title": "Mozart - Piano Concerto No. 21",
                    "description": "Solo piano performance"
                },
                {
                    "time": "21:00",
                    "title": "Beethoven - Symphony No. 5 (1st Movement)",
                    "description": "Full orchestra finale"
                },
